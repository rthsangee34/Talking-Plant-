# ─── Gemini AI ───────────────────────────────────────────────────────────────
# Required for all AI features (vision, analysis, live voice).
# Get your key from https://aistudio.google.com/apikey
GEMINI_API_KEY="your-gemini-api-key-here"

# Models (optional overrides — defaults are set in server code)
GEMINI_VISION_MODEL="gemini-3.6-flash"
GEMINI_LIVE_MODEL="gemini-3.1-flash-live-preview"

# ─── WhatsApp Cloud API (Optional) ──────────────────────────────────────────
# All five variables below are REQUIRED to enable WhatsApp integration.
# If any are missing, the server starts normally without WhatsApp.
#
# 1. Create a Meta Business App: https://developers.facebook.com/apps/
# 2. Enable WhatsApp Product and get test credentials from the dashboard.
# 3. Set up a webhook URL (your server's /api/whatsapp/webhook endpoint).

WHATSAPP_ACCESS_TOKEN="replace-me"
WHATSAPP_PHONE_NUMBER_ID="replace-me"
WHATSAPP_VERIFY_TOKEN="replace-me"
WHATSAPP_APP_SECRET="replace-me"
WHATSAPP_OWNER_NUMBER="replace-me"

# Optional WhatsApp settings
# WHATSAPP_BUSINESS_ACCOUNT_ID=""
# WHATSAPP_GRAPH_API_VERSION="v21.0"
# WHATSAPP_ALERTS_ENABLED="true"
# WHATSAPP_ALERT_COOLDOWN_MINUTES="30"
# WHATSAPP_DAILY_ALERT_LIMIT="20"
# WHATSAPP_ALERT_TEMPLATE="plant_health_alert"
# WHATSAPP_CRITICAL_TEMPLATE="plant_critical_alert"
# WHATSAPP_TEMPLATE_LANGUAGE="en"

# ─── Admin ───────────────────────────────────────────────────────────────────
# Secret for protected management endpoints (test-message, mute, etc.)
# If not set, a random value is generated each restart.
# ADMIN_SECRET="replace-me"

# ─── App URL ─────────────────────────────────────────────────────────────────
APP_URL="MY_APP_URL"
